{
  "name": "@perk-ui/components",
  "version": "0.1.0",
  "private": false,
  "workspaces": [
    "perk-ui/*",
    "demo-app"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "echo use the example app for live dev",
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist --clean",
