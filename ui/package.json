    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@babel/core": "^7.x",
    "@types/bun": "latest",
    "@types/react": "~19.x",
    "@types/react-native": "^0.72.x",
    "react-native-reanimated": "^3.x",
    "react-native-gesture-handler": "~2.x",
    "react-native-svg": "15.x",
    "bun-types": "*",
    "eslint": "^8.x",
    "tsup": "^8.5.1",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": "*",
    "react-native-svg": "*",
    "react-native-gesture-handler": "*"
  }
}